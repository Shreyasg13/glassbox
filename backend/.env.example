# Copy to .env (git-ignored) and fill in what you need. Every value here
# has a safe default if unset -- this file documents what's configurable,
# not what's required.

# --- Local/self-hosted LLM providers ---
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001

# --- Cloud LLM providers (unset = provider reports "not configured") ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini cost estimation: unset = /admin/llm-calls reports
# estimated_cost_usd=null for Gemini calls (shown as "--" in the UI) --
# this project has no authoritative live Gemini pricing source, so it
# will not guess a number. Fill both in $/1M tokens to enable estimates.
GEMINI_INPUT_COST_PER_1M=
GEMINI_OUTPUT_COST_PER_1M=

# --- Strategy Lenses text-to-speech (both optional; unset = /api/tts
# returns a clean 503, "voice output isn't configured" -- see app/tts.py) ---
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=

# --- Auth ---
# GLASSBOX_ENV=production makes the backend refuse to start with the dev
# secret below (and refuse the dev logins). Leave unset for local dev.
GLASSBOX_ENV=
GLASSBOX_JWT_SECRET=dev-only-secret-change-me
# Local-only convenience: 1 enables the old admin/admin and user/user logins.
# Never honoured when GLASSBOX_ENV=production.
GLASSBOX_ENABLE_DEV_USERS=
# Real admin login (username "admin"). See root .env.example.
GLASSBOX_ADMIN_PASSWORD_HASH=
GLASSBOX_ADMIN_PASSWORD=

# --- Rate limiting (in-process; see app/rate_limit.py) ---
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_ADMIN_PER_MIN=60

# --- Data sources ---
TRADING_STORAGE_PATH=D:/TradingStorage
BACKEND_SOURCE_PATH=../backend-source
GLASSBOX_DB_PATH=
