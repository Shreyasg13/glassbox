# Copy to .env and fill in before `docker compose up -d`.
# Never commit the real .env — it's already in .gitignore.

# ---- Domains (must have DNS A records pointing at this VM's IP already) ----
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_WS_URL=wss://api.yourdomain.com/ws/signals

# ---- Auth ----
# Generate with: openssl rand -hex 32
GLASSBOX_JWT_SECRET=

# ---- Live trading data ----
# Not an env var — place your synced TradingStorage data (data_parquet/,
# training_results/, etc.) in ./trading-storage next to this compose file.
# It's bind-mounted read-only into the backend at a fixed path. Leave the
# directory empty/absent and data_source.py falls back to reports/ instead.

# ---- LLM providers (all optional; unset = provider reports "not configured"
# in /admin/providers/health rather than failing) ----
VLLM_BASE_URL=
GEMINI_API_KEY=
GEMINI_INPUT_COST_PER_1M=
GEMINI_OUTPUT_COST_PER_1M=
ANTHROPIC_API_KEY=

# OLLAMA_BASE_URL defaults to the bundled `ollama` compose service
# (started with: docker compose --profile local-llm up -d).
# Point it elsewhere instead if you're running Ollama on a separate GPU VM.
OLLAMA_BASE_URL=http://ollama:11434

# ---- Rate limits ----
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_ADMIN_PER_MIN=60
BACKEND_WORKERS=2
